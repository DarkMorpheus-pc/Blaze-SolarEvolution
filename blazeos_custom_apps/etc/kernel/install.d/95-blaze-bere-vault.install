#!/usr/bin/bash
# Mark physical BLAZE_REC recovery vault for kernel/initrd refresh after kernel install.
COMMAND="${1:-}"
KERNEL_VERSION="${2:-}"
[ "$COMMAND" = "add" ] || exit 0
case "$KERNEL_VERSION" in
    *rescue*) exit 0 ;;
esac
[ ! -e /run/initramfs/live ] && [ ! -e /dev/mapper/live-base ] || exit 0
if command -v blkid >/dev/null 2>&1 && [ -n "$(blkid -L BLAZE_REC 2>/dev/null || true)" ]; then
    mkdir -p -m 0755 /var/lib/blazeos 2>/dev/null || :
    printf 'kernel:%s\n' "$KERNEL_VERSION" > /var/lib/blazeos/bere-vault-needs-refresh 2>/dev/null || :
fi
exit 0
