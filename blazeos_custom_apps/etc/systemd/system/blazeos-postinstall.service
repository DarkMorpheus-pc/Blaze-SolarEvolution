[Unit]
Description=BlazeOS Post-Installation Setup
Before=display-manager.service gdm.service sddm.service
After=local-fs.target
ConditionKernelCommandLine=!rd.live.image
ConditionPathExists=!/run/initramfs/live
ConditionPathExists=/usr/bin/blazeos-postinstall

[Service]
Type=oneshot
ExecStart=/usr/bin/blazeos-postinstall
RemainAfterExit=yes
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target graphical.target
