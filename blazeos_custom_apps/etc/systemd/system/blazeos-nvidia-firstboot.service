[Unit]
Description=BlazeOS NVIDIA İlk Başlatma Sürücü Kurulumu
Documentation=https://blazeos.com.tr
After=network-online.target display-manager.service
Wants=network-online.target
ConditionPathExists=!/var/lib/blazeos/nvidia-setup-done
ConditionVirtualization=!container
ConditionKernelCommandLine=!rd.live.image

[Service]
Type=oneshot
Environment=LC_ALL=C.UTF-8
ExecCondition=/usr/bin/sh -c 'LC_ALL=C.UTF-8 /usr/bin/lspci 2>/dev/null | LC_ALL=C.UTF-8 /usr/bin/grep -iq nvidia'
ExecStart=/usr/bin/blazeos-nvidia-setup
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=graphical.target
