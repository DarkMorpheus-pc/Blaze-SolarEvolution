// BlazeOS SolarUI - Hybrid KDE + Niri & Noctalia Desktop Configuration
// Flawless combination of:
// - Top: Noctalia Bar (all CachyOS features, control center, audio, visualizer, calendar)
// - Center: KDE-style Floating & Tiling Windows with CachyOS Spring Physics & Kawase Blur
// - Bottom: SolarUI KDE-style Taskbar (Start menu, open window tasks, vector SVGs, zero emojis)

spawn-at-startup "/usr/libexec/blazeos-wayland-session-ready"
spawn-at-startup "solar-shell" "autostart"

// Suppress unbranded raw compositor hotkey overlay in favor of SolarUI Welcome HUD
hotkey-overlay {
    skip-at-startup
}

input {
    keyboard {
        xkb {
            layout "tr,us"
            options "grp:alt_shift_toggle"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.2
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }
}

output "eDP-1" {
    scale 1.0
}

output "Virtual-1" {
    scale 1.0
}

layout {
    gaps 14
    center-focused-column "never"
    background-color "transparent" // Transparent so Noctalia wallpaper on backdrop is visible

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#38c8ff"
        inactive-color "#40484d"
    }

    border {
        off
    }

    server-titlebar {
        on
        height 30
        active-color "#17181d"
        inactive-color "#202229"
        active-text-color "#f4f4f6"
        inactive-text-color "#9ca3af"
        aero-snap true
        allow-minimize false
    }

    struts {
        top 10
        left 10
        right 10
        bottom 52 // Reserved space for KDE taskbar + safety margin
    }
}

// CachyOS Tuned Spring Physics Animations (Critically damped, zero overshoot, ultra fluid)
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

// Window Geometries & Glassmorphism Blur (KDE Plasma Style Floating Windows)
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    open-floating true
}

window-rule {
    background-effect {
        blur true
        xray false
    }
}

// Installer & Dialog window rules: Center Anaconda and prevent full-screen corner trapping
window-rule {
    match app-id=r#"^(anaconda|org\.fedoraproject\.Anaconda.*|Anaconda)$"#
    open-floating true
    default-column-width { proportion 0.88; }
    default-window-height { proportion 0.88; }
    geometry-corner-radius 12
    clip-to-geometry true
}

// Default primary workspace and dedicated background workspace for parked/minimized windows
workspace "1"
workspace "background"

// Blaze Setup Assistant Window Rule
window-rule {
    match app-id=r#"(org\.blazeos\.setup|blaze-setup)"#
    open-floating true
    open-focused true
    open-fullscreen true
    server-titlebar false
}

window-rule {
    match title=r#"^Blaze Setup Assistant"#
    open-floating true
    open-focused true
    open-fullscreen true
    server-titlebar false
}

// SolarUI Windows 11 Snap Layouts HUD Window Rule
window-rule {
    match app-id="^solar-snap$"
    open-floating true
    server-titlebar false
    default-floating-position x=0 y=54 relative-to="top"
    default-column-width { fixed 440; }
    default-window-height { fixed 260; }
    geometry-corner-radius 16
    clip-to-geometry true
}

// Live Installer Window Rule (Floating Centered, 82% screen proportion, never auto-maximize)
window-rule {
    match app-id="^liveinst$"
    open-floating true
    open-focused true
    open-maximized false
    open-maximized-to-edges false
    open-fullscreen false
    default-column-width { proportion 0.82; }
    default-window-height { proportion 0.82; }
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match app-id="^firefox$"
    open-floating true
    open-focused true
    default-column-width { proportion 0.82; }
    default-window-height { proportion 0.82; }
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^(org\.blazeos\.gamezone\.browser|blaze-gamezone-browser)$"#
    open-floating true
    open-focused true
    server-titlebar false
    default-column-width { proportion 0.94; }
    default-window-height { proportion 0.92; }
    geometry-corner-radius 18
    clip-to-geometry true
}

// Dialog & System Utility Windows Rule (Open Floating)
window-rule {
    match is-floating=true
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^(org\.gnome\.FileRoller|org\.gnome\.NautilusPreviewer|polkit-gnome-authentication-agent-1|pavucontrol)$"#
    open-floating true
}

// BlazeOS Control Center & Native Tools
window-rule {
    match app-id=r#"^(org\.blazeos\.control|blazeos-welcome|blaze-house)$"#
    open-floating true
    open-focused true
    server-titlebar false
    default-column-width { proportion 0.75; }
    default-window-height { proportion 0.80; }
    geometry-corner-radius 16
    clip-to-geometry true
}

// FireHub App Store & Native Electron/SSD Apps (with crisp Minimize / Maximize / Close titlebar)
window-rule {
    match app-id=r#"^(FireHub|firehub)$"#
    open-floating true
    open-focused true
    server-titlebar true
    default-column-width { proportion 0.78; }
    default-window-height { proportion 0.82; }
    geometry-corner-radius 16
    clip-to-geometry true
}

// SolarUI KDE Taskbar Window Rule
window-rule {
    match app-id="solar-shell"
    open-floating true
    server-titlebar false
    default-floating-position x=0 y=0 relative-to="bottom-left"
    default-column-width { proportion 1.0; }
    default-window-height { fixed 44; }
}

// Noctalia Settings Window Rule
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    open-focused true
    server-titlebar false
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// SolarUI Settings Window Rule
window-rule {
    match app-id="^solar-settings$"
    open-floating true
    open-focused true
    server-titlebar false
    default-column-width { fixed 1020; }
    default-window-height { fixed 620; }
    geometry-corner-radius 20
    clip-to-geometry true
}

// Alacritty & Wayland Terminal Window Rule (Wide enough for zero Fastfetch line wrapping)
window-rule {
    match app-id=r#"^(Alacritty|org\.Alacritty|foot|kitty)$"#
    open-floating true
    server-titlebar true
    default-column-width { fixed 1020; }
    default-window-height { fixed 540; }
    geometry-corner-radius 20
    clip-to-geometry true
}

// SolarUI Welcome & Shortcuts Window Rule
window-rule {
    match app-id="^solar-welcome$"
    open-floating true
    server-titlebar false
    default-column-width { fixed 750; }
    default-window-height { fixed 590; }
    geometry-corner-radius 20
    clip-to-geometry true
}

// SolarUI Native Installer Window Rule
window-rule {
    match app-id="^solar-installer-gui$"
    open-floating true
    server-titlebar false
    default-column-width { fixed 920; }
    default-window-height { fixed 640; }
    geometry-corner-radius 20
    clip-to-geometry true
}

// SolarUI Omnibar (Raycast / Spotlight Command Hub)
window-rule {
    match app-id="^solar-omnibar$"
    open-floating true
    server-titlebar false
    default-column-width { fixed 720; }
    default-window-height { fixed 490; }
    geometry-corner-radius 22
    clip-to-geometry true
}

// Blaze GameZone Fullscreen Gaming Shell & Native/Proton Games (Zero Blur / Zero Corner Clipping)
window-rule {
    match app-id="^solar-gamezone$"
    open-focused true
    open-fullscreen true
    server-titlebar false
    geometry-corner-radius 0
    clip-to-geometry false
    background-effect {
        blur false
    }
}

window-rule {
    match app-id=r#"^(steam_app_.*|gamescope|cs2|dota2|hl2_linux|lutris)$"#
    open-floating false
    server-titlebar false
    geometry-corner-radius 0
    clip-to-geometry false
    background-effect {
        blur false
    }
}

// Steam & Dialog Window Rules
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

// SolarUI Google Pixel Clock Widget
window-rule {
    match app-id="^solar-clock$"
    open-floating true
    open-focused false
    server-titlebar false
    default-floating-position x=0 y=70 relative-to="top"
    default-column-width { fixed 460; }
    default-window-height { fixed 280; }
    geometry-corner-radius 0
    clip-to-geometry false
    background-effect {
        blur false
    }
}

// Layer Shell Rules for Noctalia
layer-rule {
    match namespace="^noctalia-(desktop-widget|wallpaper).*"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

binds {
    // ── Workspace & Window Navigation ──────────────────────────────
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }

    // ── Window Actions (KDE & Console GameZone Habits) ────────────
    Mod+Q             { close-window; }
    Ctrl+Shift+X      { close-window; }
    Alt+F4            { close-window; }
    Mod+Y             { spawn-sh "solar-shell minimize"; }
    Mod+Ctrl+Down     { spawn-sh "solar-shell minimize"; }
    Mod+T             { toggle-window-floating; }
    Mod+F             { toggle-window-floating; }
    Mod+M             { maximize-column; }
    Mod+Shift+F       { fullscreen-window; }
    Mod+Z             { spawn-sh "solar-shell snap"; }
    Mod+Shift+V       { switch-focus-between-floating-and-tiling; }
    Mod+Tab           { toggle-overview; }
    Mod+D             { spawn "solar-shell" "route" "dashboard"; }

    // ── Console & Desktop Workspace Switching (Ctrl+Shift+1..4 & Mod+1..4) ──
    Ctrl+Shift+1      { focus-workspace 1; }
    Ctrl+Shift+2      { focus-workspace 2; }
    Ctrl+Shift+3      { focus-workspace 3; }
    Ctrl+Shift+4      { focus-workspace 4; }
    Mod+1             { focus-workspace 1; }
    Mod+2             { focus-workspace 2; }
    Mod+3             { focus-workspace 3; }
    Mod+4             { focus-workspace 4; }

    // ── SolarUI Panels & Settings (Routed via SolarSurfaceRouter) ──
    Mod+Space           { spawn "solar-shell" "omnibar"; }
    Mod+Shift+Space     { spawn "solar-shell" "omnibar" "--force"; }
    Mod+Alt+Space       { spawn "solar-shell" "route" "launcher"; }
    Mod+G               { spawn "solar-shell" "gamezone"; }
    Mod+Alt+K           { spawn "solar-shell" "easter-egg" "konami"; }
    Mod+S               { spawn "solar-shell" "route" "control-center"; }
    Mod+I               { spawn "solar-shell" "settings"; }
    Mod+Comma           { spawn "solar-shell" "route" "settings"; }
    Mod+Shift+S         { spawn "solar-shell" "settings"; }
    Mod+Shift+Q         { spawn "solar-shell" "route" "session"; }
    Mod+Alt+R           { spawn "solar-shell" "supervisor"; }
    Mod+Alt+S           { spawn "solar-shell" "settings"; }
    Mod+F1              { spawn "solar-shell" "welcome"; }
    Mod+Shift+Escape    { spawn "solar-shell" "welcome"; }

    // ── Quick App Launchers ────────────────────────────────────────
    Mod+Return { spawn "sh" "-c" "command -v kitty >/dev/null && exec kitty || exec alacritty"; }
    Ctrl+Alt+T { spawn "sh" "-c" "command -v kitty >/dev/null && exec kitty || exec alacritty"; }
    Mod+H      { spawn "firehub"; }
    Mod+E      { spawn "nautilus"; }
    Mod+B      { spawn "sh" "-c" "command -v google-chrome-stable >/dev/null && exec google-chrome-stable || command -v firefox >/dev/null && exec firefox || exec xdg-open https://www.google.com"; }

    // ── Audio & Media Keys ─────────────────────────────────────────
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // ── Brightness Keys ────────────────────────────────────────────
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // ── Screenshots ────────────────────────────────────────────────
    Print     { spawn "sh" "-c" "IMG=$(mktemp --suffix=.png) && grim -g \"$(slurp)\" \"$IMG\" && wl-copy < \"$IMG\" && swappy -f \"$IMG\"; rm -f \"$IMG\""; }
    Alt+Print { spawn "sh" "-c" "IMG=$(mktemp --suffix=.png) && grim \"$IMG\" && wl-copy < \"$IMG\" && swappy -f \"$IMG\"; rm -f \"$IMG\""; }

    // ── Session ────────────────────────────────────────────────────
    Mod+Shift+E     { quit; }
    Ctrl+Alt+Delete { spawn "blaze-system-monitor"; }
    Mod+L           { spawn "solar-lock"; }
}

// GameZone modal dialogs (external game scanner & Proton-GE manager) must be compact centered floating windows
window-rule {
    match title=r#"^(Harici Oyun veya Klasör Tanıt|Add External Game or Folder|Blaze Proton-GE & Uyumluluk Yöneticisi|Blaze Proton-GE & Compatibility Manager)$"#
    open-floating true
    open-focused true
    default-column-width { fixed 640; }
    default-window-height { fixed 380; }
    geometry-corner-radius 20
    clip-to-geometry true
}

// Make every launched app (Electron/Chromium: FireHub, Firefox, ...) pick the Wayland backend
environment {
    XDG_SESSION_TYPE "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    MOZ_ENABLE_WAYLAND "1"
}
