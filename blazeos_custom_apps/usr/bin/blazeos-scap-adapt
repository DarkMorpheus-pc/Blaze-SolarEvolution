#!/usr/bin/env python3
"""Generate a read-only Blaze SolarEvolution Fedora-45-compatible SCAP datastream.

Preserves upstream /usr/share/xml/scap/ssg/content/ssg-fedora-ds.xml untouched
and writes /usr/share/blazeos/scap/ssg-blazeos-fedora45-ds.xml with explicit
BlazeOS CPE + OVAL applicability checks:
- ID=blazeos
- BLAZE_BASE_ID=fedora
- BLAZE_BASE_VERSION_ID=45
- /etc/system-release-cpe matching cpe:/o:blazeos:solarevolution:5.05*
- fedora-release* and blaze-release RPMs installed
"""
from __future__ import annotations

import argparse
import os
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

DEFAULT_SRC_DS = Path("/usr/share/xml/scap/ssg/content/ssg-fedora-ds.xml")
DEFAULT_DST_DS = Path("/usr/share/blazeos/scap/ssg-blazeos-fedora45-ds.xml")
CPE_NS = "http://cpe.mitre.org/dictionary/2.0"
OVAL_DEF_NS = "http://oval.mitre.org/XMLSchema/oval-definitions-5"
OVAL_IND_NS = "http://oval.mitre.org/XMLSchema/oval-definitions-5#independent"
OVAL_LIN_NS = "http://oval.mitre.org/XMLSchema/oval-definitions-5#linux"
XCCDF_12_NS = "http://checklists.nist.gov/xccdf/1.2"
XCCDF_11_NS = "http://checklists.nist.gov/xccdf/1.1"
BLAZE_CPE_NAMES = (
    ("cpe:/o:blazeos:solarevolution:5.05.1", "Blaze SolarEvolution 5.05.1 (Fedora 45 Base)"),
    ("cpe:/o:blazeos:solarevolution:5.05", "Blaze SolarEvolution 5.05 (Fedora 45 Base)"),
)
BLAZE_DEF_ID = "oval:blazeos-installed_OS_is_solarevolution_fedora45:def:1"


def adapt_fedora_datastream(src: Path, dst: Path) -> None:
    if not src.is_file():
        raise FileNotFoundError(f"Upstream Fedora SCAP datastream not found: {src}")

    tree = ET.parse(src)
    root = tree.getroot()

    # 1. Inject BlazeOS CPE items into the CPE dictionary component
    for comp in root:
        if comp.attrib.get("id") == "scap_org.open-scap_comp_ssg-fedora-cpe-dictionary.xml":
            for cpe_list in comp.iter(f"{{{CPE_NS}}}cpe-list"):
                existing = {el.attrib.get("name") for el in cpe_list.findall(f"{{{CPE_NS}}}cpe-item")}
                for cpe_uri, title_txt in BLAZE_CPE_NAMES:
                    if cpe_uri in existing:
                        continue
                    item = ET.SubElement(cpe_list, f"{{{CPE_NS}}}cpe-item", {"name": cpe_uri})
                    t_el = ET.SubElement(item, f"{{{CPE_NS}}}title", {"{http://www.w3.org/XML/1998/namespace}lang": "en-us"})
                    t_el.text = title_txt
                    chk = ET.SubElement(
                        item,
                        f"{{{CPE_NS}}}check",
                        {"system": OVAL_DEF_NS, "href": "ssg-fedora-cpe-oval.xml"},
                    )
                    chk.text = BLAZE_DEF_ID

    # 2. Add BlazeOS platform idrefs alongside Fedora platforms at Benchmark top-level
    for comp in root:
        if comp.attrib.get("id") == "scap_org.open-scap_comp_ssg-fedora-xccdf.xml":
            for ns in (XCCDF_12_NS, XCCDF_11_NS):
                for bench in comp.iter(f"{{{ns}}}Benchmark"):
                    existing_plats = {el.attrib.get("idref") for el in bench.findall(f"{{{ns}}}platform")}
                    insert_idx = 0
                    for idx, ch in enumerate(list(bench)):
                        if ch.tag == f"{{{ns}}}platform":
                            insert_idx = idx + 1
                    for cpe_uri, _ in BLAZE_CPE_NAMES:
                        if cpe_uri not in existing_plats:
                            plat = ET.Element(f"{{{ns}}}platform", {"idref": cpe_uri})
                            bench.insert(insert_idx, plat)
                            insert_idx += 1

    # 3. Inject BlazeOS OVAL inventory definition & tests into cpe-oval component
    for comp in root:
        if comp.attrib.get("id") == "scap_org.open-scap_comp_ssg-fedora-cpe-oval.xml":
            oval_defs = next(comp.iter(f"{{{OVAL_DEF_NS}}}oval_definitions"), None)
            if oval_defs is None:
                continue
            defs_el = oval_defs.find(f"{{{OVAL_DEF_NS}}}definitions")
            tests_el = oval_defs.find(f"{{{OVAL_DEF_NS}}}tests")
            objs_el = oval_defs.find(f"{{{OVAL_DEF_NS}}}objects")
            if defs_el is None or tests_el is None or objs_el is None:
                continue

            if not any(d.attrib.get("id") == BLAZE_DEF_ID for d in defs_el):
                d_el = ET.SubElement(defs_el, f"{{{OVAL_DEF_NS}}}definition", {
                    "id": BLAZE_DEF_ID,
                    "version": "1",
                    "class": "inventory",
                })
                meta = ET.SubElement(d_el, f"{{{OVAL_DEF_NS}}}metadata")
                ET.SubElement(meta, f"{{{OVAL_DEF_NS}}}title").text = (
                    "Installed operating system is Blaze SolarEvolution (Fedora 45 base)"
                )
                aff = ET.SubElement(meta, f"{{{OVAL_DEF_NS}}}affected", {"family": "unix"})
                ET.SubElement(aff, f"{{{OVAL_DEF_NS}}}platform").text = "Fedora"
                ET.SubElement(meta, f"{{{OVAL_DEF_NS}}}reference", {
                    "ref_id": "cpe:/o:blazeos:solarevolution:5.05.1",
                    "source": "CPE",
                })
                ET.SubElement(meta, f"{{{OVAL_DEF_NS}}}description").text = (
                    "Verifies ID=blazeos, BLAZE_BASE_ID=fedora, BLAZE_BASE_VERSION_ID=45, "
                    "/etc/system-release-cpe, fedora-release*, and blaze-release."
                )
                crit = ET.SubElement(d_el, f"{{{OVAL_DEF_NS}}}criteria", {"operator": "AND"})
                ET.SubElement(crit, f"{{{OVAL_DEF_NS}}}extend_definition", {
                    "comment": "Installed OS is part of the Unix family",
                    "definition_ref": "oval:ssg-installed_OS_is_part_of_Unix_family:def:1",
                })
                ET.SubElement(crit, f"{{{OVAL_DEF_NS}}}criterion", {
                    "comment": "fedora-release RPM packages are installed",
                    "test_ref": "oval:ssg-test_fedora_release_rpm:tst:1",
                })
                ET.SubElement(crit, f"{{{OVAL_DEF_NS}}}criterion", {
                    "comment": "blaze-release RPM package is installed",
                    "test_ref": "oval:blazeos-test_blaze_release_rpm:tst:1",
                })
                ET.SubElement(crit, f"{{{OVAL_DEF_NS}}}criterion", {
                    "comment": "ID=blazeos in /etc/os-release",
                    "test_ref": "oval:blazeos-test_osrel_id:tst:1",
                })
                ET.SubElement(crit, f"{{{OVAL_DEF_NS}}}criterion", {
                    "comment": "BLAZE_BASE_ID=fedora in /etc/os-release",
                    "test_ref": "oval:blazeos-test_osrel_base_id:tst:1",
                })
                ET.SubElement(crit, f"{{{OVAL_DEF_NS}}}criterion", {
                    "comment": "BLAZE_BASE_VERSION_ID=45 in /etc/os-release",
                    "test_ref": "oval:blazeos-test_osrel_base_ver:tst:1",
                })
                ET.SubElement(crit, f"{{{OVAL_DEF_NS}}}criterion", {
                    "comment": "/etc/system-release-cpe identifies cpe:/o:blazeos:solarevolution:5.05*",
                    "test_ref": "oval:blazeos-test_cpe_solarevolution:tst:1",
                })

            existing_tests = {t.attrib.get("id") for t in tests_el}
            existing_objs = {o.attrib.get("id") for o in objs_el}

            def add_txt_check(tid: str, oid: str, comment: str, filepath: str, pattern: str) -> None:
                if tid not in existing_tests:
                    t = ET.SubElement(tests_el, f"{{{OVAL_IND_NS}}}textfilecontent54_test", {
                        "id": tid, "version": "1", "check": "all", "comment": comment, "state_operator": "AND",
                    })
                    ET.SubElement(t, f"{{{OVAL_IND_NS}}}object", {"object_ref": oid})
                if oid not in existing_objs:
                    o = ET.SubElement(objs_el, f"{{{OVAL_IND_NS}}}textfilecontent54_object", {
                        "id": oid, "version": "1",
                    })
                    ET.SubElement(o, f"{{{OVAL_IND_NS}}}filepath").text = filepath
                    ET.SubElement(o, f"{{{OVAL_IND_NS}}}pattern", {"operation": "pattern match"}).text = pattern
                    ET.SubElement(o, f"{{{OVAL_IND_NS}}}instance", {"datatype": "int", "operation": "equals"}).text = "1"

            if "oval:blazeos-test_blaze_release_rpm:tst:1" not in existing_tests:
                t = ET.SubElement(tests_el, f"{{{OVAL_LIN_NS}}}rpminfo_test", {
                    "id": "oval:blazeos-test_blaze_release_rpm:tst:1",
                    "version": "1",
                    "check": "all",
                    "comment": "blaze-release RPM package is installed",
                    "state_operator": "AND",
                })
                ET.SubElement(t, f"{{{OVAL_LIN_NS}}}object", {"object_ref": "oval:blazeos-object_blaze_release_rpm:obj:1"})
            if "oval:blazeos-object_blaze_release_rpm:obj:1" not in existing_objs:
                o = ET.SubElement(objs_el, f"{{{OVAL_LIN_NS}}}rpminfo_object", {
                    "id": "oval:blazeos-object_blaze_release_rpm:obj:1", "version": "1",
                })
                ET.SubElement(o, f"{{{OVAL_LIN_NS}}}name").text = "blaze-release"

            add_txt_check(
                "oval:blazeos-test_osrel_id:tst:1",
                "oval:blazeos-object_osrel_id:obj:1",
                "ID=blazeos in /etc/os-release",
                "/etc/os-release",
                "^ID=blazeos$",
            )
            add_txt_check(
                "oval:blazeos-test_osrel_base_id:tst:1",
                "oval:blazeos-object_osrel_base_id:obj:1",
                "BLAZE_BASE_ID=fedora in /etc/os-release",
                "/etc/os-release",
                "^BLAZE_BASE_ID=fedora$",
            )
            add_txt_check(
                "oval:blazeos-test_osrel_base_ver:tst:1",
                "oval:blazeos-object_osrel_base_ver:obj:1",
                "BLAZE_BASE_VERSION_ID=45 in /etc/os-release",
                "/etc/os-release",
                "^BLAZE_BASE_VERSION_ID=45$",
            )
            add_txt_check(
                "oval:blazeos-test_cpe_solarevolution:tst:1",
                "oval:blazeos-object_cpe_solarevolution:obj:1",
                "CPE identifies Blaze SolarEvolution 5.05*",
                "/etc/system-release-cpe",
                r"^cpe:/o:blazeos:solarevolution:5\.05(\.[0-9]+)?$",
            )

    dst.parent.mkdir(parents=True, exist_ok=True)
    tmp = dst.with_name(f".{dst.name}.tmp.{os.getpid()}")
    tree.write(tmp, encoding="utf-8", xml_declaration=True)
    os.chmod(tmp, 0o644)
    os.replace(tmp, dst)


def main() -> int:
    ap = argparse.ArgumentParser(description="Build Blaze SolarEvolution SCAP datastream from Fedora SSG.")
    ap.add_argument("--src", type=Path, default=DEFAULT_SRC_DS)
    ap.add_argument("--dst", type=Path, default=DEFAULT_DST_DS)
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()
    if not args.src.is_file():
        if not args.quiet:
            print(f"[blaze-scap-compat] Upstream datastream not present ({args.src}); skipping.")
        return 0
    adapt_fedora_datastream(args.src, args.dst)
    if not args.quiet:
        print(f"[blaze-scap-compat] Generated {args.dst} from {args.src}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
