#!/usr/bin/env bash
# =============================================================================
# BlazeOS İlk Kurulum — first-boot setup wizard (v2)
# TR/EN/DE/RU | YAD tabanlı | ayrıcalıklı işler /usr/libexec/blazeos-welcome-helper
# üzerinden TEK pkexec ile | donanım-farkında masaüstü önerisi
# =============================================================================

set -u
SCRIPT_NAME="BlazeOS"
WIZARD_VERSION="2.0.0"
CONFIG_DIR="$HOME/.config/blazeos"
MARKER_FILE="$CONFIG_DIR/.welcome-completed"
LOGO_PATH="/usr/share/blazeos/icons/blazeos-logo.png"
HELPER="/usr/libexec/blazeos-welcome-helper"

mkdir -p "$CONFIG_DIR"

mark_welcome_completed() {
    {
        echo "completed_at=$(date -Iseconds)"
        echo "version=$WIZARD_VERSION"
        echo "ram_gb=${MEM_GB:-0}"
    } > "$MARKER_FILE" 2>/dev/null || true
}

# --force: uygulama menüsünden yeniden çalıştırınca canlı-geçidi + marker atlanır
FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

# ---- CANLI SİSTEM GEÇİDİ ----------------------------------------------------
# Sihirbaz yalnızca KURULU sistemde çalışmalı; Live ISO oturumunda çıkar.
if [ "$FORCE" -eq 0 ] && grep -qE 'rd\.live\.image|root=live:' /proc/cmdline 2>/dev/null; then
    exit 0
fi

# ---- Zaten tamamlandı mı? sessizce çık (--force ile atlanır) ----------------
[ "$FORCE" -eq 0 ] && [ -f "$MARKER_FILE" ] && exit 0

# Ensure marker is always written on exit in normal first-boot mode so autostart
# never re-runs endlessly (including on SolarUI where solar-shell handles welcome
# or when yad is unavailable).
if [ "$FORCE" -eq 0 ]; then
    trap 'mark_welcome_completed' EXIT
fi

if [ "$FORCE" -eq 0 ]; then
    case "${XDG_CURRENT_DESKTOP:-}:${DESKTOP_SESSION:-}" in
        *SolarUI*|*solarui*|*niri*|*Niri*)
            mark_welcome_completed
            exit 0
            ;;
    esac
fi

if ! command -v yad >/dev/null 2>&1; then
    mark_welcome_completed
    exit 0
fi

# ---- Dil algıla + kullanıcıya sor ------------------------------------------
SYS_LANG="${LANG%_*}"
case "$SYS_LANG" in
    tr) LANGUAGE=tr ;;
    ru) LANGUAGE=ru ;;
    de) LANGUAGE=de ;;
    *)  LANGUAGE=en ;;
esac

# Dil seçim ekranı — kullanıcı sistem dilini geçersiz kılabilir
LANG_PICK=$(yad \
    --width=360 --height=220 --center --borders=20 \
    --title="BlazeOS" \
    --text="<b>Dil seçin / Select language / Выберите язык</b>" \
    --list --separator="" --no-headers \
    --column="Language" \
    "Türkçe" \
    "English" \
    "Русский" \
    --button="OK!gtk-ok:0" 2>/dev/null) && true
case "$LANG_PICK" in
    *Türkçe*)  LANGUAGE=tr ;;
    *English*) LANGUAGE=en ;;
    *Русский*) LANGUAGE=ru ;;
esac

# ---- Donanım: toplam RAM (GB, en yakına yuvarlanmış) ------------------------
MEM_KB=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
MEM_GB=$(( (MEM_KB + 524288) / 1048576 ))
[ "$MEM_GB" -lt 1 ] && MEM_GB=1
# Hafif öneri eşiği: 4 GB ve altı için XFCE veya Cinnamon önerilir
LOW_RAM=0
[ "$MEM_GB" -le 4 ] && LOW_RAM=1

# ---- i18n -------------------------------------------------------------------
t() {
    case "$LANGUAGE:$1" in
        tr:welcome_title)    echo "BlazeOS ilk kurulum" ;;
        tr:welcome_text)     echo "Bu araç Blaze SolarEvolution kurulumunu tamamlamak için güncelleme, masaüstü ortamı ve Waydroid seçeneklerini sunar." ;;
        tr:btn_continue)     echo "Devam et" ;;
        tr:btn_ok)           echo "Tamam" ;;
        tr:btn_skip)         echo "Atla" ;;
        tr:btn_back)         echo "Geri" ;;
        tr:step_update)          echo "Sistem güncellemesi" ;;
        tr:step_update_text)     echo "Hangi güncelleme türünü yapmak istersiniz?" ;;
        tr:upd_all)              echo "Tam güncelleme" ;;
        tr:upd_all_info)         echo "Tüm sistem paketleri, çekirdek, donanım sürücüleri ve güvenlik yamaları güncellenir.\n\nSüre: 10-30 dk\nÖnerilen: her yeni kurulumdan sonra" ;;
        tr:upd_drivers)          echo "Yalnızca sürücüler" ;;
        tr:upd_drivers_info)     echo "Çekirdek, firmware, Mesa/Vulkan grafik sürücüleri ve donanım modülleri güncellenir.\n\nSüre: 5-15 dk\nÖnerilen: yeni donanım veya ekran/ses sorunları varsa" ;;
        tr:upd_security)         echo "Yalnızca güvenlik" ;;
        tr:upd_security_info)    echo "Yalnızca CVE güvenlik yamaları uygulanır. Paket sürümleri değişmez.\n\nSüre: 1-10 dk\nÖnerilen: hızlı güvenlik yaması" ;;
        tr:upd_packages)         echo "Yalnızca bileşenler" ;;
        tr:upd_packages_info)    echo "Uygulamalar ve kütüphaneler güncellenir. Çekirdek ve sürücüler hariç tutulur.\n\nSüre: 5-20 dk\nÖnerilen: çekirdek değiştirmek istemiyorsanız" ;;
        tr:upd_info_btn)         echo "Bilgi" ;;
