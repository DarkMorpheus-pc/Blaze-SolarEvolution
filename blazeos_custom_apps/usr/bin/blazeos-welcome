        ru:ram_ok)           echo "Обнаружено RAM: ${MEM_GB} ГБ. Все среды работают комфортно." ;;
        ru:step_done)        echo "Настройка завершена" ;;
        ru:step_done_text)   echo "Blaze SolarEvolution готов к работе.\n\nПоддержка: blazeos.com.tr" ;;
