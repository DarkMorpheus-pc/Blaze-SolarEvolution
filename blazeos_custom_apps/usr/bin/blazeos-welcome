        ru:dock_none)        echo "Нет (стандартный GNOME)" ;;
        ru:dock_dtd)         echo "Dash to Dock (классический боковой dock)" ;;
        ru:dock_hint)        echo "Выберите вариант и нажмите Продолжить. Чтобы пропустить, нажмите Пропустить." ;;

        de:welcome_title)    echo "BlazeOS Ersteinrichtung" ;;
