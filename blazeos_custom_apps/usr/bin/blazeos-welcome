        tr:de_done_t)        echo "Masaüstü hazır" ;;
        tr:de_switch)        echo "Yeni masaüstüne geçmek için:\n\n1) Oturumu kapatın.\n2) Parola giriş ekranının sağ altındaki oturum simgesine tıklayın.\n3) Listeden yeni masaüstünü seçip giriş yapın." ;;
        tr:step_dock)        echo "Dock" ;;
