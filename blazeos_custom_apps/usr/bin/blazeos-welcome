        *:welcome_title)     echo "BlazeOS first setup" ;;
        *:welcome_text)      echo "This assistant covers system updates, optional desktop environments, and Waydroid setup for Blaze SolarEvolution." ;;
        *:btn_continue)      echo "Continue" ;;
        *:btn_ok)            echo "OK" ;;
        *:btn_skip)          echo "Skip" ;;
        *:btn_back)          echo "Back" ;;
        *:step_update)           echo "System update" ;;
        *:step_update_text)      echo "Which type of update would you like to perform?" ;;
        *:upd_all)               echo "Full update" ;;
        *:upd_all_info)          echo "All packages: kernel, drivers, security patches and apps.\n\nTime: 10-30 min\nRecommended: after a fresh install" ;;
        *:upd_drivers)           echo "Drivers only" ;;
        *:upd_drivers_info)      echo "Kernel, firmware, Mesa/Vulkan and hardware modules.\n\nTime: 5-15 min" ;;
        *:upd_security)          echo "Security only" ;;
        *:upd_security_info)     echo "Critical CVE patches only. No version changes.\n\nTime: 1-10 min" ;;
        *:upd_packages)          echo "Components only" ;;
        *:upd_packages_info)     echo "Apps and libraries. Kernel and drivers excluded.\n\nTime: 5-20 min" ;;
        *:upd_info_btn)          echo "Info" ;;
        *:step_waydroid)     echo "Waydroid setup" ;;
        *:step_waydroid_text) echo "Set up Waydroid to run Android apps?\n\nFirst the package (~30 MB) will be installed, then Android images (~700 MB-1.5 GB) will be downloaded." ;;
        *:step_de)           echo "Desktop environment" ;;
