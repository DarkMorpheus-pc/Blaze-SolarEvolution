#!/usr/bin/env bash
# blaze-snapshot - btrfs root snapshots with bootable entries and rollback.
#
# Layout (Fedora default btrfs): "/" is the subvolume "root" of the top-level
# subvolume (id 5). Snapshots live in the nested subvolume /.blaze-snapshots, which
# is NOT part of a snapshot of "/" (nested subvolumes are excluded), so snapshots
# never contain other snapshots.
#
# Commands:
#   status                         show whether snapshots are supported and why not
#   create [--reason R] [desc]     take a read-only snapshot of /
#   list                           list snapshots
#   restore <name>                 roll back root subvolume to <name> (sets ro=false)
#   delete <name>                  delete a snapshot and its boot entry
#   prune [keep]                   keep the newest N auto snapshots (default 5)
#   boot-entries                   (re)generate GRUB/BLS boot entries for all snapshots
#   promote                        make the currently booted snapshot the new "root"
#   pre-transaction                used by the dnf5 hook: auto snapshot before changes
set -euo pipefail
export LC_ALL=C.UTF-8

SNAPDIR="/.blaze-snapshots"
STATE="/var/lib/blaze/snapshot"
KEEP_DEFAULT="${BLAZE_SNAPSHOT_KEEP:-5}"
BLS_DIR="/boot/loader/entries"
TOP_MNT="/mnt/.blaze-btrfs-root"
GRUB_SNAP_SCRIPT="/etc/grub.d/41_blaze_snapshots"
_ACTIVE_MNT=""

cleanup_mount() {
    if [ -n "${_ACTIVE_MNT:-}" ]; then
        umount "$_ACTIVE_MNT" 2>/dev/null || true
        _ACTIVE_MNT=""
    fi
}

die()  { echo "blaze-snapshot: $*" >&2; exit 1; }
say()  { echo "blaze-snapshot: $*"; }
need_root() { [ "$(id -u)" -eq 0 ] || die "must be run as root"; }

root_fstype() { findmnt -no FSTYPE / 2>/dev/null || true; }
root_source() { findmnt -no SOURCE / 2>/dev/null | sed 's/\[.*//' || true; }
root_subvol() {
    local fsr
    fsr="$(findmnt -no FSROOT / 2>/dev/null | sed 's#^/##' || true)"
    if [ -n "$fsr" ]; then
        echo "$fsr"
        return 0
    fi
    findmnt -no OPTIONS / 2>/dev/null | tr ',' '\n' | sed -n 's/^subvol=//p' | sed 's#^/##'
}

supported() {
    command -v btrfs >/dev/null 2>&1 || { REASON="btrfs-progs is not installed"; return 1; }
    [ "$(root_fstype)" = "btrfs" ] || { REASON="root filesystem is $(root_fstype), not btrfs"; return 1; }
    return 0
}

require_supported() {
    supported || die "snapshots unavailable: $REASON"
}

ensure_snapdir() {
    if [ ! -d "$SNAPDIR" ]; then
        btrfs subvolume create "$SNAPDIR" >/dev/null
        chmod 0750 "$SNAPDIR"
    fi
    mkdir -p "$STATE"
}

snap_name() { date -u +%Y%m%dT%H%M%SZ; }

kernel_of_snapshot() {
    # newest kernel version inside the snapshot that still has files in /boot
    local snap="$1" v
    for v in $(ls -1 "$snap/usr/lib/modules" 2>/dev/null | sort -rV); do
        [ -e "/boot/vmlinuz-$v" ] && { echo "$v"; return 0; }
    done
    return 1
}

write_grub_snapshot_script() {
    mkdir -p /etc/grub.d
    cat > "$GRUB_SNAP_SCRIPT" <<'GRUBEOF'
#!/usr/bin/sh
set -e
[ -f /boot/grub2/blaze-snapshots.cfg ] && cat <<'CFG'
if [ -f ${config_directory}/blaze-snapshots.cfg ]; then
  source ${config_directory}/blaze-snapshots.cfg
elif [ -f ${prefix}/blaze-snapshots.cfg ]; then
  source ${prefix}/blaze-snapshots.cfg
fi
CFG
exit 0
GRUBEOF
    chmod 0755 "$GRUB_SNAP_SCRIPT"
}

write_boot_entry() {
    local name="$1" snap="$SNAPDIR/$1" kver tpl out cur_sub prefix_sub
    [ -d "$BLS_DIR" ] || return 0
    kver="$(kernel_of_snapshot "$snap")" || { say "no matching kernel in /boot for $name; no boot entry"; return 0; }
    tpl="$(ls -1t "$BLS_DIR"/*"$kver".conf 2>/dev/null | grep -v blaze-snap | head -n1 || true)"
    [ -n "$tpl" ] || tpl="$(ls -1t "$BLS_DIR"/*.conf 2>/dev/null | grep -v blaze-snap | head -n1 || true)"
    [ -n "$tpl" ] || return 0
    cur_sub="$(root_subvol)"
    case "$cur_sub" in
        ""|.blaze-snapshots/*|.snapshots/*) prefix_sub=".blaze-snapshots/$name" ;;
        *) prefix_sub="$cur_sub/.blaze-snapshots/$name" ;;
    esac
    out="$BLS_DIR/blaze-snap-$name.conf"
    # Reuse linux/initrd/options of the host entry; point root to the snapshot subvolume.
    sed -E \
        -e "s#^title .*#title Blaze snapshot $name (kernel $kver)#" \
        -e "s#^version .*#version $kver-snapshot-$name#" \
        -e "s#^id .*#id blaze-snap-$name#" \
        -e "s#rootflags=subvol=[^ ]+#rootflags=subvol=$prefix_sub#" \
        "$tpl" > "$out"
    grep -q '^options.*rootflags=' "$out" || sed -i -E "s#^options (.*)#options \1 rootflags=subvol=$prefix_sub#" "$out"
    grep -q '^id ' "$out" || echo "id blaze-snap-$name" >> "$out"
    write_grub_snapshot_script
    say "boot entry written: $(basename "$out")"
}

preserve_nested_snapshots() {
    local old_root="$1" new_root="$2" nested
    for nested in .blaze-snapshots .snapshots; do
        if [ -d "$old_root/$nested" ]; then
            rmdir "$new_root/$nested" 2>/dev/null || true
            if [ ! -e "$new_root/$nested" ]; then
                mv "$old_root/$nested" "$new_root/$nested"
            fi
        fi
    done
}

cmd_status() {
    if supported; then
        say "supported: root is btrfs (subvol=$(root_subvol), source=$(root_source))"
        [ -d "$SNAPDIR" ] && say "snapshots: $(ls -1 "$SNAPDIR" 2>/dev/null | wc -l)" || say "snapshots: 0 (no snapshot directory yet)"
    else
        say "NOT supported: $REASON"
        say "Install on btrfs (Fedora default) to enable rollback."
        return 2
    fi
}

cmd_create() {
    need_root; require_supported; ensure_snapdir
    local reason="manual" desc="" name
    while [ $# -gt 0 ]; do
        case "$1" in
            --reason)
                reason="${2:-manual}"
                shift 2 || shift
                ;;
            --reason=*)
                reason="${1#*=}"
                shift
                ;;
            *)
                desc="$1"
                shift
                ;;
        esac
    done
    [ -n "$desc" ] || desc="$reason"
    name="$(snap_name)"
    btrfs subvolume snapshot -r / "$SNAPDIR/$name" >/dev/null
    printf '%s\n' "$desc" > "$STATE/$name.desc"
    say "created $name ($desc)"
    write_boot_entry "$name"
    # Never run slow synchronous grub2-mkconfig during dnf-pre transactions
    if [ "$reason" != "dnf-pre" ] && [ "${BLAZE_UPDATE_GRUB:-0}" = "1" ] && command -v grub2-mkconfig >/dev/null 2>&1; then
        nohup grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1 &
    fi
}

cmd_list() {
    require_supported
    [ -d "$SNAPDIR" ] || { say "no snapshots"; return 0; }
    printf '%-18s %s\n' NAME DESCRIPTION
    local n
    for n in $(ls -1 "$SNAPDIR" 2>/dev/null | sort); do
        printf '%-18s %s\n' "$n" "$(cat "$STATE/$n.desc" 2>/dev/null || echo -)"
    done
}

cmd_restore() {
    need_root; require_supported
    local SNAP_NAME="${1:-}"
    [ -n "$SNAP_NAME" ] || die "usage: restore <name>"
    [[ "$SNAP_NAME" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid snapshot name: $SNAP_NAME"

    local dev CURRENT_SUBVOL MOUNT_DIR stamp OLD_SUBVOL SNAP_SRC
    dev="$(root_source)"
    [ -n "$dev" ] || die "could not determine root block device"
    CURRENT_SUBVOL="$(root_subvol)"
    case "$CURRENT_SUBVOL" in
        ""|*/*) CURRENT_SUBVOL="root" ;;
    esac

    MOUNT_DIR="$TOP_MNT"
    mkdir -p "$MOUNT_DIR"
    mount -o subvolid=5 "$dev" "$MOUNT_DIR"
    _ACTIVE_MNT="$MOUNT_DIR"
    trap cleanup_mount EXIT RETURN

    if [ ! -d "$MOUNT_DIR/$CURRENT_SUBVOL" ]; then
        if [ -d "$MOUNT_DIR/root" ]; then
            CURRENT_SUBVOL="root"
        elif [ -d "$MOUNT_DIR/@" ]; then
            CURRENT_SUBVOL="@"
        else
            die "active root subvolume '$CURRENT_SUBVOL' not found on top-level btrfs volume"
        fi
    fi

    # Verify the target snapshot exists before moving current root subvol
    if [ -d "$MOUNT_DIR/$CURRENT_SUBVOL/.blaze-snapshots/$SNAP_NAME" ]; then
        :
    elif [ -d "$MOUNT_DIR/.blaze-snapshots/$SNAP_NAME" ]; then
        :
    elif [ -d "$MOUNT_DIR/$CURRENT_SUBVOL/.snapshots/$SNAP_NAME" ]; then
        :
    else
        die "snapshot not found: $SNAP_NAME"
    fi

    stamp="$(snap_name)"
    OLD_SUBVOL="${CURRENT_SUBVOL}_old_${stamp}"
    mv "$MOUNT_DIR/$CURRENT_SUBVOL" "$MOUNT_DIR/$OLD_SUBVOL"

    if [ -d "$MOUNT_DIR/$OLD_SUBVOL/.blaze-snapshots/$SNAP_NAME" ]; then
        SNAP_SRC="$MOUNT_DIR/$OLD_SUBVOL/.blaze-snapshots/$SNAP_NAME"
    elif [ -d "$MOUNT_DIR/.blaze-snapshots/$SNAP_NAME" ]; then
        SNAP_SRC="$MOUNT_DIR/.blaze-snapshots/$SNAP_NAME"
    elif [ -d "$MOUNT_DIR/$OLD_SUBVOL/.snapshots/$SNAP_NAME" ]; then
        SNAP_SRC="$MOUNT_DIR/$OLD_SUBVOL/.snapshots/$SNAP_NAME"
    else
        mv "$MOUNT_DIR/$OLD_SUBVOL" "$MOUNT_DIR/$CURRENT_SUBVOL"
        die "snapshot source vanished after rename: $SNAP_NAME"
    fi

    if ! btrfs subvolume snapshot "$SNAP_SRC" "$MOUNT_DIR/$CURRENT_SUBVOL" >/dev/null; then
        mv "$MOUNT_DIR/$OLD_SUBVOL" "$MOUNT_DIR/$CURRENT_SUBVOL"
        die "failed to create writable root subvolume from $SNAP_SRC"
    fi

    # Explicitly ensure restored root subvolume is read-write (ro=false)
    btrfs property set -ts "$MOUNT_DIR/$CURRENT_SUBVOL" ro false

    # Move nested .blaze-snapshots and .snapshots into the restored root subvolume
    preserve_nested_snapshots "$MOUNT_DIR/$OLD_SUBVOL" "$MOUNT_DIR/$CURRENT_SUBVOL"

    cleanup_mount
    trap - EXIT RETURN
    say "restored '$SNAP_NAME' to '$CURRENT_SUBVOL' (ro=false). Previous root saved as '$OLD_SUBVOL'."
}

cmd_delete() {
    need_root; require_supported
    local name="${1:-}"; [ -n "$name" ] || die "usage: delete <name>"
    [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid snapshot name"
    [ -d "$SNAPDIR/$name" ] || die "no such snapshot: $name"
    case "$(root_subvol)" in
        *".blaze-snapshots/$name") die "cannot delete the snapshot you are booted from" ;;
    esac
    btrfs subvolume delete "$SNAPDIR/$name" >/dev/null
    rm -f "$STATE/$name.desc" "$BLS_DIR/blaze-snap-$name.conf"
    say "deleted $name"
}

cmd_prune() {
    need_root; require_supported
    local keep="${1:-$KEEP_DEFAULT}" n total i=0
    [[ "$keep" =~ ^[0-9]+$ ]] || die "invalid keep count (expected non-negative integer): $keep"
    [ -d "$SNAPDIR" ] || return 0
    total="$(ls -1 "$SNAPDIR" | wc -l)"
    for n in $(ls -1 "$SNAPDIR" | sort); do
        i=$((i+1))
        [ $((total - i)) -ge "$keep" ] || break
        case "$(root_subvol)" in
            *".blaze-snapshots/$n") ;;
            *) cmd_delete "$n" ;;
        esac
    done
}

cmd_boot_entries() {
    need_root; require_supported
    rm -f "$BLS_DIR"/blaze-snap-*.conf
    local n
    for n in $(ls -1 "$SNAPDIR" 2>/dev/null | sort); do write_boot_entry "$n"; done
}

cmd_promote() {
    need_root; require_supported
    local cur; cur="$(root_subvol)"
    case "$cur" in
        *.blaze-snapshots/*) ;;
        *) die "you are booted from '$cur'. Boot a snapshot from the boot menu first, then run promote." ;;
    esac
    local dev; dev="$(root_source)"
    mkdir -p "$TOP_MNT"
    mount -o subvolid=5 "$dev" "$TOP_MNT"
    _ACTIVE_MNT="$TOP_MNT"
    trap cleanup_mount EXIT RETURN
    local stamp; stamp="$(snap_name)"
    [ -d "$TOP_MNT/root" ] || die "top-level subvolume 'root' not found; unsupported layout"
    local old_root="$TOP_MNT/root.before-rollback-$stamp"
    mv "$TOP_MNT/root" "$old_root"
    local snap_rel="${cur#root/}"
    local snap_src="$old_root/$snap_rel"
    [ -d "$snap_src" ] || snap_src="$TOP_MNT/$cur"
    btrfs subvolume snapshot "$snap_src" "$TOP_MNT/root" >/dev/null
    btrfs property set -ts "$TOP_MNT/root" ro false
    preserve_nested_snapshots "$old_root" "$TOP_MNT/root"
    cleanup_mount
    trap - EXIT RETURN
    say "promoted $cur to 'root' (ro=false). Previous system kept as 'root.before-rollback-$stamp'."
    say "Reboot and choose the normal Blaze entry."
}

cmd_pre_transaction() {
    # Called by the dnf5 actions plugin; never block package operations on failure,
    # and pass --reason dnf-pre so synchronous grub2-mkconfig is never run on every dnf call.
    supported || exit 0
    [ "$(id -u)" -eq 0 ] || exit 0
    { cmd_create --reason dnf-pre "before dnf transaction" && cmd_prune "$KEEP_DEFAULT"; } || say "pre-transaction snapshot failed (continuing)" >&2
    exit 0
}

case "${1:-status}" in
    status) cmd_status ;;
    create) shift; cmd_create "$@" ;;
    list) cmd_list ;;
    restore|rollback) shift; cmd_restore "$@" ;;
    delete) shift; cmd_delete "$@" ;;
    prune) shift; cmd_prune "$@" ;;
    boot-entries) cmd_boot_entries ;;
    promote) cmd_promote ;;
    pre-transaction) cmd_pre_transaction ;;
    -h|--help|help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $1 (try --help)" ;;
esac
